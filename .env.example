# ============================================================
# DisputeForge — Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# --- Neon (Postgres 16 + pgvector) ---
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/disputeforge?sslmode=require

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Kafka ---
KAFKA_BROKERS=kafka:9092

# --- Node Service ---
NODE_PORT=3000
NODE_ENV=development

# --- FastAPI Service ---
FASTAPI_PORT=8000

# --- Internal Service Token (shared secret for Node ↔ FastAPI internal API) ---
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# --- Clerk (Auth) — Phase 1 ---
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# --- Stripe (Test Mode) — Phase 3 ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Google Gemini / Embedding Model (Free Tier) — Phase 1 ---
GEMINI_API_KEY=your_gemini_api_key_here

